{
  "name": "url-shortener",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:http": "node scripts/verify-http.mjs",
    "postbuild": "node scripts/standalone-assets.mjs",
    "test:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "qr-code-styling": "1.9.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsqr": "1.4.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
